<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ups_device_list" model="ir.ui.view">
        <field name="name">ups.device.list</field>
        <field name="model">ups.device</field>
        <field name="arch" type="xml">
            <list decoration-danger="on_battery" decoration-muted="agent_state == 'offline'">
                <field name="name"/>
                <field name="model"/>
                <field name="status"/>
                <field name="battery_charge" widget="progressbar"/>
                <field name="input_voltage"/>
                <field name="ups_load"/>
                <field name="last_seen"/>
                <field name="agent_state" widget="badge" decoration-success="agent_state == 'online'" decoration-danger="agent_state == 'offline'"/>
                <field name="on_battery" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_ups_device_kanban" model="ir.ui.view">
        <field name="name">ups.device.kanban</field>
        <field name="model">ups.device</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_order="name">
                <field name="on_battery"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="agent_state" widget="badge" decoration-success="agent_state == 'online'" decoration-danger="agent_state == 'offline'"/>
                        </div>
                        <div t-att-class="record.on_battery.raw_value ? 'text-danger fw-bold' : 'text-success'">
                            <field name="status"/>
                        </div>
                        <div>
                            <span>Battery</span> <field name="battery_charge"/><span t-translation="off"> %</span>
                            <span t-translation="off"> · </span><span>Load</span> <field name="ups_load"/><span t-translation="off"> %</span>
                        </div>
                        <div>
                            <span>Mains</span> <field name="input_voltage"/><span t-translation="off"> V</span>
                            <span t-translation="off"> · </span><span>Runtime</span> <field name="battery_runtime"/><span t-translation="off"> s</span>
                        </div>
                        <div class="text-muted"><span>Last seen</span> <field name="last_seen" widget="remaining_days"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ups_device_form" model="ir.ui.view">
        <field name="name">ups.device.form</field>
        <field name="model">ups.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_dashboard" type="object" class="oe_stat_button" icon="fa-tachometer" string="Dashboard"/>
                        <button name="action_open_charts" type="object" class="oe_stat_button" icon="fa-line-chart" string="Charts"/>
                        <button name="action_open_outages" type="object" class="oe_stat_button" icon="fa-bolt">
                            <field name="outage_count" widget="statinfo" string="Outages"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="serial"/>
                            <field name="manufacturer"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="agent_state" widget="badge" decoration-success="agent_state == 'online'" decoration-danger="agent_state == 'offline'"/>
                            <field name="last_seen"/>
                            <field name="status"/>
                            <field name="on_battery"/>
                        </group>
                    </group>
                    <group string="Latest values">
                        <group>
                            <field name="battery_charge"/>
                            <field name="battery_runtime"/>
                            <field name="battery_voltage"/>
                        </group>
                        <group>
                            <field name="input_voltage"/>
                            <field name="ups_load"/>
                            <field name="nominal_power"/>
                            <field name="transfer_low"/>
                            <field name="transfer_high"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="NUT variables" name="vars">
                            <field name="vars_json"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ups_device" model="ir.actions.act_window">
        <field name="name">UPS</field>
        <field name="res_model">ups.device</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
