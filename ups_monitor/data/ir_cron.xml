<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_check_agents" model="ir.cron">
        <field name="name">UPS Monitor: flag silent agents</field>
        <field name="model_id" ref="model_ups_device"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_agents()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_purge_samples" model="ir.cron">
        <field name="name">UPS Monitor: purge old samples</field>
        <field name="model_id" ref="model_ups_device"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_samples()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
