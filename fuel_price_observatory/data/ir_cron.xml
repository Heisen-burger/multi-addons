<odoo noupdate="1">

    <record id="ir_cron_sync_prices" model="ir.cron">
        <field name="name">Fuel Prices: Sync Prices from MIMIT API</field>
        <field name="model_id" ref="model_fuel_station_fuel"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_prices()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="priority">50</field>
    </record>

    <record id="ir_cron_sync_stations" model="ir.cron">
        <field name="name">Fuel Prices: Sync Stations from MIMIT CSV</field>
        <field name="model_id" ref="model_fuel_station"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_stations()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=7, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="priority">60</field>
    </record>

</odoo>
