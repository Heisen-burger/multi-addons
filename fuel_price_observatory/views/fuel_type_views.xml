<odoo>

    <record id="view_fuel_type_list" model="ir.ui.view">
        <field name="name">fuel.type.list</field>
        <field name="model">fuel.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_fuel_type" model="ir.actions.act_window">
        <field name="name">Fuel Types</field>
        <field name="res_model">fuel.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fuel type yet</p>
            <p>The station sync caches the families MIMIT publishes.</p>
        </field>
    </record>

    <menuitem id="menu_fuel_type" name="Fuel Types" parent="menu_fuel_config"
              action="action_fuel_type" sequence="40"/>

</odoo>
