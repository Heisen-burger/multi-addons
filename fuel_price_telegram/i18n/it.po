#. module: fuel_price_telegram
#. odoo-python
#: code:addons/fuel_price_telegram/models/telegram_handler.py:0
msgid ""
"%(name)s, now %(price).3f, alert %(rule)s.\n"
"Send the new rule:\n"
"<code>sopra 1.85</code> alert above 1.85\n"
"<code>sotto 1.70</code> alert below 1.70\n"
"<code>1.70-1.85</code> alert outside the range\n"
"<code>nessuna</code> alert at every change"
msgstr ""
"%(name)s, ora %(price).3f, avviso %(rule)s.\n"
"Manda la nuova regola:\n"
"<code>sopra 1.85</code> avvisa sopra 1.85\n"
"<code>sotto 1.70</code> avvisa sotto 1.70\n"
"<code>1.70-1.85</code> avvisa fuori dall'intervallo\n"
"<code>nessuna</code> avvisa a ogni variazione"

