<odoo>

    <record id="action_register_webhook" model="ir.actions.server">
        <field name="name">Telegram: Register Webhook</field>
        <field name="model_id" ref="model_telegram_bot"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="code">action = model.action_register_webhook()</field>
    </record>

    <menuitem id="menu_telegram_register_webhook" name="Register Webhook"
              parent="menu_telegram_root" action="action_register_webhook" sequence="90"/>

</odoo>
