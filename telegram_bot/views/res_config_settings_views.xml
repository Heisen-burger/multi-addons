<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.telegram_bot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Telegram" string="Telegram" name="telegram_bot"
                     logo="/telegram_bot/static/description/icon.png">
                    <block title="Bot" name="telegram_bot_block">
                        <setting id="telegram_bot_token" string="Bot Token"
                                 help="Token from @BotFather. Then run Settings > Technical > Telegram > Register Webhook.">
                            <field name="telegram_bot_token" password="True"/>
                        </setting>
                        <setting id="telegram_bot_secret" string="Webhook Secret"
                                 help="Checked on every webhook call. Leave empty to generate one.">
                            <field name="telegram_webhook_secret" password="True"/>
                        </setting>
                        <setting id="telegram_bot_welcome" string="Welcome Message"
                                 help="Answer to /start when no module overrides it.">
                            <field name="telegram_welcome"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
