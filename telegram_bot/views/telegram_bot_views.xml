<odoo>

    <record id="view_telegram_bot_list" model="ir.ui.view">
        <field name="name">telegram.bot.list</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kind"/>
                <field name="username"/>
                <field name="access_code" optional="hide"/>
                <field name="chat_count"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_bot_form" model="ir.ui.view">
        <field name="name">telegram.bot.form</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_register_webhook" type="object" string="Register Webhook"
                            class="btn-primary" groups="base.group_system"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Bot name"/></h1>
                    </div>
                    <group>
                        <group name="bot">
                            <field name="kind"/>
                            <field name="token" password="True" groups="base.group_system"/>
                            <field name="username"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="access">
                            <field name="access_code"/>
                            <field name="webhook_secret" password="True" groups="base.group_system"/>
                            <field name="webhook_url"/>
                            <field name="chat_count"/>
                        </group>
                    </group>
                    <group string="Welcome Message" name="welcome">
                        <field name="welcome" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_bot" model="ir.actions.act_window">
        <field name="name">Telegram Bots</field>
        <field name="res_model">telegram.bot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bot yet</p>
            <p>Create one with @BotFather, paste the token here and register the webhook.</p>
        </field>
    </record>

    <menuitem id="menu_telegram_root" name="Telegram" parent="base.menu_custom" sequence="60"/>
    <menuitem id="menu_telegram_bot" name="Bots" parent="menu_telegram_root"
              action="action_telegram_bot" sequence="5"/>

</odoo>
